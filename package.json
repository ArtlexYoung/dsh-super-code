{
  "name": "dsh-super-agent",
  "version": "0.0.5",
  "description": "Scenario presets and an event-sourced task protocol for DeepSeek Harness.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./core/*": {
      "types": "./lib/core/*.d.ts",
      "default": "./lib/core/*.js"
    },
    "./dsh": {
      "types": "./lib/dsh/index.d.ts",
      "default": "./lib/dsh/index.js"
    },
    "./presets/*": "./presets/*",
    "./package.json": "./package.json",
    "./client": "./client/index.js"
  },
  "files": [
    "lib",
    "presets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "client"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-agent-presets": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "^0.1.2-rc.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "agent-presets",
    "workflow",
    "research",
    "optimization"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtlexYang/dsh-super-agent.git"
  },
  "homepage": "https://github.com/ArtlexYang/dsh-super-agent#readme",
  "bugs": {
    "url": "https://github.com/ArtlexYang/dsh-super-agent/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  }
}
