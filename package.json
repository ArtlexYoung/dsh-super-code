{
  "name": "dsh-super-code",
  "version": "0.4.0",
  "description": "Task-focused coding, specialist teams, and durable task memory with directory and declarative presets for DeepSeek Harness.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "super-code-mcp": "lib/connection-cli.js",
    "super-code-eval": "lib/evaluate.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./dsh": {
      "types": "./lib/dsh/index.d.ts",
      "default": "./lib/dsh/index.js"
    },
    "./super-code": {
      "types": "./lib/dsh/super-code.d.ts",
      "default": "./lib/dsh/super-code.js"
    },
    "./presets/*": "./presets/*",
    "./builtin/*": "./builtin/*",
    "./package.json": "./package.json",
    "./locale/*": "./locales/*",
    "./dsh/locale/*": "./locales/*",
    "./super-code/locale/*": "./locales/*",
    "./client": "./dist/client.js",
    "./evaluation": {
      "types": "./lib/core/evaluation.d.ts",
      "default": "./lib/core/evaluation.js"
    },
    "./experiments": {
      "types": "./lib/experiments.d.ts",
      "default": "./lib/experiments.js"
    },
    "./compaction": {
      "types": "./lib/dsh/compaction.d.ts",
      "default": "./lib/dsh/compaction.js"
    },
    "./shell": {
      "types": "./lib/dsh/windows-shell.d.ts",
      "default": "./lib/dsh/windows-shell.js"
    },
    "./skills": {
      "types": "./lib/dsh/bundled-skills.d.ts",
      "default": "./lib/dsh/bundled-skills.js"
    }
  },
  "files": [
    "lib",
    "presets",
    "builtin",
    "runtime/windows",
    "runtime/skills/openspec",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "docs/Changelog.md",
    "docs/Compatibility.md",
    "docs/UsageGuide.md",
    "docs/EvaluationResults.md",
    "docs/Acknowledgements.md",
    "docs/en/*.md",
    "docs/images/agent-tree.png",
    "docs/images/agent-tree-preview.png",
    "docs/images/task-status.png",
    "docs/images/task-status-preview.png",
    "docs/images/preset-settings.png",
    "docs/images/preset-settings-preview.png",
    "docs/images/install-tgz.png",
    "docs/images/install-tgz-preview.png",
    "docs/images/star-history.svg",
    "docs/images/star-history-dark.svg",
    "docs/images/npm-downloads.svg",
    "docs/images/npm-downloads-dark.svg",
    "LICENSE",
    "dist/client.js",
    "dist/git.cjs",
    "locales",
    "dist/THIRD_PARTY_NOTICES.txt",
    "docs/CodeWorkbench.md"
  ],
  "dependencies": {
    "@fission-ai/openspec": "1.17.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "js-yaml": "^4.1.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2 || ^4.0.5-alpha.1 || ^4.0.6-alpha.1",
    "@deepseek-ai/dsh-agent": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.2.0-rc.1 || ^0.2.1-alpha.1 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-compaction": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.2.0-rc.1 || ^0.2.1-alpha.1 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-compaction-basic": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.2.0-rc.1 || ^0.2.1-alpha.1 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.2.0-rc.1 || ^0.2.1-alpha.1 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-scope": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.2.0-rc.1 || ^0.2.1-alpha.1 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.2.0-rc.1 || ^0.2.1-alpha.1 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-projection": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.2.0-rc.1 || ^0.2.1-alpha.1 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-settings": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.2.0-rc.1 || ^0.2.1-alpha.1 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-skill": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.2.0-rc.1 || ^0.2.1-alpha.1 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-skill-filesystem": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.2.0-rc.1 || ^0.2.1-alpha.1 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-storage-domain": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.2.0-rc.1 || ^0.2.1-alpha.1 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.2.0-rc.1 || ^0.2.1-alpha.1 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-token-meter": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.2.0-rc.1 || ^0.2.1-alpha.1 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.2.0-rc.1 || ^0.2.1-alpha.1 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.2.0-rc.1 || ^0.2.1-alpha.1 || ^0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2 || ^3.18.5-alpha.1 || ^3.18.6-alpha.1",
    "@deepseek-ai/dsh-fs": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.2.0-rc.1 || ^0.2.1-alpha.1 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-sandbox": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.2.0-rc.1 || ^0.2.1-alpha.1 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-sandbox-policy": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.2.0-rc.1 || ^0.2.1-alpha.1 || ^0.2.2-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-php": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/lint": "6.9.8",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@deepseek-ai/dsh-agent-presets": "0.1.5-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.5-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "0.1.5-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.1.5-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.5-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.5-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.1.5-rc.2",
    "@deepseek-ai/dsh-storage": "0.1.5-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.5-rc.2",
    "@deepseek-ai/dsh-storage-json": "0.1.5-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.1.5-rc.2",
    "@lezer/highlight": "1.2.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "diff": "9.0.0",
    "esbuild": "0.28.2",
    "isomorphic-git": "1.44.13",
    "playwright": "1.61.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "skills:build": "node runtime/skills/pstack/convert.mjs",
    "skills:check": "node runtime/skills/pstack/convert.mjs --check",
    "build": "npm run skills:build && npm run client:build && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run skills:check && tsx --test \"test/**/*.test.ts\"",
    "pack:check": "npm pack --dry-run",
    "eval:super-code": "node lib/evaluate.js",
    "client:build": "node runtime/workbench/build.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "agent-presets",
    "workflow",
    "research",
    "optimization"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtlexYoung/dsh-super-code.git"
  },
  "homepage": "https://github.com/ArtlexYoung/dsh-super-code#readme",
  "bugs": {
    "url": "https://github.com/ArtlexYoung/dsh-super-code/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-skill"
      ]
    }
  }
}
