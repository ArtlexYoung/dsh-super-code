{
  "name": "dsh-super-code",
  "version": "0.1.4",
  "description": "Task-focused coding, specialist teams, and durable task memory with directory and declarative presets for DeepSeek Harness.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "super-code-eval": "lib/evaluate.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./dsh": {
      "types": "./lib/dsh/index.d.ts",
      "default": "./lib/dsh/index.js"
    },
    "./super-code": {
      "types": "./lib/dsh/super-code.d.ts",
      "default": "./lib/dsh/super-code.js"
    },
    "./presets/*": "./presets/*",
    "./package.json": "./package.json",
    "./client": "./client/index.js",
    "./evaluation": {
      "types": "./lib/core/evaluation.d.ts",
      "default": "./lib/core/evaluation.js"
    },
    "./experiments": {
      "types": "./lib/experiments.d.ts",
      "default": "./lib/experiments.js"
    }
  },
  "files": [
    "lib",
    "presets",
    "cordis.patch.yml",
    "README.md",
    "docs/Changelog.md",
    "docs/Compatibility.md",
    "docs/UsageGuide.md",
    "docs/EvaluationResults.md",
    "docs/images/agent-tree.png",
    "docs/images/agent-tree-preview.png",
    "docs/images/preset-settings.png",
    "docs/images/preset-settings-preview.png",
    "LICENSE",
    "client"
  ],
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1",
    "@deepseek-ai/dsh-agent-presets": "^0.1.5-alpha.1 || ^0.1.6-alpha.1",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1",
    "@deepseek-ai/dsh-session": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1",
    "@deepseek-ai/dsh-session-projection": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1",
    "@deepseek-ai/dsh-scope": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/dsh-settings": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "pack:check": "npm pack --dry-run",
    "eval:super-code": "node lib/evaluate.js"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "agent-presets",
    "workflow",
    "research",
    "optimization"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtlexYoung/dsh-super-code.git"
  },
  "homepage": "https://github.com/ArtlexYoung/dsh-super-code#readme",
  "bugs": {
    "url": "https://github.com/ArtlexYoung/dsh-super-code/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  }
}
